    min: 0
    max: -1
    default_value: 0
    is_flag: false
    options: []
    skip_output_if_default: false
  grwc:
    name: growl (curve)
    abbr: grwc
    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ""
    skip_output_if_default: false
  rpit:
    name: rendered pitch (masked curve)
